# Do not commit actual credentials. Settings in the app can also store these locally.
PORT=3000
HOST=127.0.0.1
# Set APP_PASSWORD before binding beyond loopback / publishing behind a TLS proxy.
APP_PASSWORD=
# HTTPS origin when deployed behind your authenticated reverse proxy.
# APP_ORIGIN=https://your-domain.example
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/google/callback
# Optional external writable data directory (contains local encryption key).
# DATA_DIR=/workspace/kaden-concierge-data
